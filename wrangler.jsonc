// Cloudflare deployment settings for Spannr. "name" must match the Worker name in the Cloudflare dashboard.
// The app is a static single-page app: Cloudflare serves the built files in ./dist and sends any unknown
// path (e.g. /jobs/123, /v/<token>) to index.html. worker.js sends spannr.au to the home page.
{
  "name": "mechanic-app",
  "compatibility_date": "2025-06-01",
  "main": "worker.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  }
}
